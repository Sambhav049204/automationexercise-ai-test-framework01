<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.automationexercise</groupId>
    <artifactId>automationexercise-ai-test-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>AutomationExercise AI Test Framework</name>
    <description>AI-powered Selenium TestNG test automation framework for automationexercise.com</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <selenium.version>4.52.0</selenium.version>
        <testng.version>7.12.0</testng.version>
        <log4j.version>2.25.3</log4j.version>
        <surefire.version>3.5.6</surefire.version>
        <excluded.groups>demo,explore</excluded.groups>
        <jackson.version>2.22.4</jackson.version>
    </properties>

    <dependencies>
        <!-- Browser automation: WebDriver API, Chrome and Edge drivers, Selenium Manager -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- Test framework. Compile scope (not test) because BaseTest and the
             listeners live in src/main/java and use TestNG classes. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Logging: API plus the implementation -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Bridge: routes SLF4J calls (used internally by TestNG) into Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>
                <!-- JSON parsing for test data files (and, later, structured AI responses) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Runs TestNG tests during "mvn test". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- "demo" tests fail or flake on purpose and only run on request:
                         mvn test "-Dexcluded.groups=none" "-Dgroups=demo" -->
                    <excludedGroups>${excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>